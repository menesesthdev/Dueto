# Variáveis do deploy de produção (infra/docker-compose.prod.yml).
# Copie para infra/.env NA EC2 (o arquivo .env é gitignored) e preencha. Segredos NUNCA vão para o repositório.

# Domínio do PWA/API (sem https://). O DNS precisa apontar para o IP da EC2 antes do primeiro `up`.
DUETO_DOMAIN=dueto.exemplo.com

# Dono (usuário ou organização) do GitHub onde a imagem foi publicada, em minúsculas.
GHCR_OWNER=menesesthdev
# Tag versionada da imagem, por exemplo sha-1a2b3c4 ou v1.0.0. Nunca use "latest" em produção.
API_TAG=

# Banco. Gere a senha com: openssl rand -hex 24   (só letras e números: ela entra na string de conexão)
POSTGRES_DB=dueto
POSTGRES_USER=dueto
POSTGRES_PASSWORD=

# Sub-rede Docker do compose. A API confia no X-Forwarded-For só desta faixa. Só mude se houver conflito.
DUETO_SUBNET=172.30.0.0/24

# Pasta com o Angular compilado (padrão: infra/web).
WEB_ROOT=./web

# Arquivo do catálogo importado pela API ao subir (padrão: infra/catalog.json, versionado no repositório).
CATALOG_FILE=./catalog.json

# Web Push (VAPID). Deixe vazio para manter o recurso desligado.
# Gere o par com: npx web-push generate-vapid-keys   (a privada é segredo)
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# mailto: ou https://, sem espaços e sem <>. A Apple recusa (BadJwtToken) outro formato.
PUSH_VAPID_SUBJECT=mailto:voce@exemplo.com
