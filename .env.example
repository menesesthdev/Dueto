# Exemplo de variáveis de ambiente do Dueto (back-end).
# Copie para `.env` (que é gitignored) e ajuste. Segredos NUNCA vão para o repositório.

# String de conexão do Postgres. Em dev, bate com o infra/docker-compose.dev.yml.
# O ASP.NET lê "Database__ConnectionString" como a seção Database:ConnectionString.
Database__ConnectionString=Host=localhost;Port=5432;Database=dueto;Username=dueto;Password=dueto

# CORS: origens do navegador autorizadas (o domínio do PWA). Sem curinga e sem caminho.
# HTTPS é obrigatório; http só é aceito para localhost. Vazio = nenhuma origem aceita.
Cors__AllowedOrigins__0=http://localhost:4200

# Rate limit por IP nos endpoints públicos (janela fixa). Padrão: 60 requisições por 60 s.
RateLimiting__PublicPermitLimit=60
RateLimiting__PublicWindowSeconds=60

# Pareamento: validade do código de 6 dígitos, em minutos (padrão 5).
Pairing__CodeTtlMinutes=5

# Rate limit do pareamento: por IP (padrão 5 por 60 s) e teto GLOBAL em pairing/complete (padrão 30 por janela).
RateLimiting__PairingPermitLimit=5
RateLimiting__PairingWindowSeconds=60
RateLimiting__PairingCompleteGlobalPermitLimit=30

# Web Push (VAPID). Sem as chaves o recurso fica DESLIGADO (nenhum push, nenhum lembrete).
# Gere o par com: npx web-push generate-vapid-keys   (a privada é segredo: nunca no repositório)
Push__VapidPublicKey=
Push__VapidPrivateKey=
# Contato do remetente: mailto: ou URL https, sem espaços nem <>. A Apple recusa (BadJwtToken) outro formato.
Push__VapidSubject=mailto:voce@exemplo.com
# Intervalo da varredura de lembretes, em segundos (padrão 15).
Push__SchedulerIntervalSeconds=15
# Lembretes, em minutos (padrão 2, 15 e 60). Índices: Push__ReminderDelaysMinutes__0=2 ...
# Hosts de push service aceitos (padrão: push.apple.com, fcm.googleapis.com, push.services.mozilla.com, notify.windows.com).
