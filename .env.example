# Exemplo de variáveis de ambiente do Dueto (back-end).
# Copie para `.env` (que é gitignored) e ajuste. Segredos NUNCA vão para o repositório.

# String de conexão do Postgres. Em dev, bate com o infra/docker-compose.dev.yml.
# O ASP.NET lê "Database__ConnectionString" como a seção Database:ConnectionString.
Database__ConnectionString=Host=localhost;Port=5432;Database=dueto;Username=dueto;Password=dueto
